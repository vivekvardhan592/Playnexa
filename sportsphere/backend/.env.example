# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection Strings (PostgreSQL & MongoDB)
DATABASE_URL=postgresql://user:password@localhost:5432/sportsphere
MONGO_URI=mongodb://localhost:27017/sportsphere

# Redis Cache & Coordination URL
REDIS_URL=redis://localhost:6379

# Cryptographic Secrets & Token Claims
JWT_SECRET=sportsphere_ultra_secure_jwt_secret_2026_key
JWT_ISSUER=sportsphere.api
JWT_AUDIENCE=sportsphere.app
COOKIE_NAME=sportsphere_access_token
COOKIE_SECRET=sportsphere_cookie_signing_secret_2026

# Origin & Client CORS URL
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
